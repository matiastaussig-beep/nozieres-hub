# Copiar a .env y completar. NUNCA subir .env a GitHub.
DOMINIO=taller.tudominio.com.ar
APP_URL=https://taller.tudominio.com.ar
AUTH_SECRET=         # una frase larga al azar (>= 32 caracteres)
CRON_SECRET=         # otra frase al azar (para el monitor externo)
GITHUB_REPO=usuario/nozieres-hub

# Respaldo continuo (Cloudflare R2 o cualquier S3)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://<id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# WhatsApp Business Cloud API (opcional: sin esto, los mensajes quedan en /mensajes para enviar con un toque)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# Correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
